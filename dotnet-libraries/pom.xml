<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.zuhayrkhan.lifecycle</groupId>
    <artifactId>lifecycle-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>dotnet-libraries</artifactId>
  <packaging>pom</packaging>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>dotnet</executable>
          <workingDirectory>${project.basedir}</workingDirectory>
        </configuration>
        <executions>
          <execution>
            <id>dotnet-restore</id>
            <phase>initialize</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>restore</argument>
                <argument>Lifecycle.sln</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-build</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>build</argument>
                <argument>Lifecycle.sln</argument>
                <argument>--no-restore</argument>
                <argument>--configuration</argument>
                <argument>Release</argument>
                <argument>-p:Version=${project.version}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <arguments>
                <argument>test</argument>
                <argument>Lifecycle.sln</argument>
                <argument>--no-build</argument>
                <argument>--no-restore</argument>
                <argument>--configuration</argument>
                <argument>Release</argument>
                <argument>--logger</argument>
                <argument>trx</argument>
                <argument>--results-directory</argument>
                <argument>${project.build.directory}/test-results</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-pack</id>
            <phase>package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>pack</argument>
                <argument>Lifecycle.sln</argument>
                <argument>--no-build</argument>
                <argument>--no-restore</argument>
                <argument>--configuration</argument>
                <argument>Release</argument>
                <argument>--output</argument>
                <argument>${project.build.directory}/packages</argument>
                <argument>-p:Version=${project.version}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <configuration>
          <filesets>
            <fileset>
              <directory>${project.basedir}</directory>
              <includes>
                <include>**/bin/**</include>
                <include>**/obj/**</include>
              </includes>
            </fileset>
          </filesets>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
